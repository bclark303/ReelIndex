# Browser address: http://localhost:8080
APP_PORT=8080

# Host folder mounted read-only at /media inside the backend container.
# Windows example: MEDIA_PATH=D:/Movies
# Linux example: MEDIA_PATH=/mnt/media/Movies
MEDIA_PATH=./sample-media

# Optional global poster/description fallback. A per-source token can also be entered in the UI.
TMDB_API_TOKEN=

# Set true to seed a small synthetic inventory for UI demonstration.
DEMO_MODE=false
LOG_LEVEL=INFO
